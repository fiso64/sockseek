<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sockseek</AssemblyName>
    <RootNamespace>Sockseek.Cli</RootNamespace>
    <!-- The application and several dependencies use reflection and are not trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <WebUiProjectDirectory>$(MSBuildProjectDirectory)/../webui</WebUiProjectDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" Version="11.0.0" />
    <!-- Managed Wu quantization preserves the terminal renderer's bounded palette. -->
    <PackageReference Include="KGySoft.Drawing.Core" Version="10.0.2" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sockseek.Api/Sockseek.Api.csproj" />
    <ProjectReference Include="../Sockseek.Core/Sockseek.Core.csproj" />
    <ProjectReference Include="../Sockseek.Server/Sockseek.Server.csproj" />
    <ProjectReference Include="../Sockseek.Persistence/Sockseek.Persistence.csproj" />
  </ItemGroup>

  <!-- Server's executable entry point exists only for build-time OpenAPI generation.
       The distributed daemon uses the CLI's runtime/dependency configuration. -->
  <Target Name="RemoveServerToolingConfiguration" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Sockseek.Server.runtimeconfig.json' or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Sockseek.Server.deps.json'" />
    </ItemGroup>
  </Target>

  <!-- Portable releases carry their assets in the CLI assembly. Folder publishes
       also support separately built assets (Docker and Nix). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SkipWebUiBuild)' != 'true'">
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <DefineConstants>$(DefineConstants);EMBEDDED_WEB_ASSETS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GenerateEmbeddedFilesManifest)' == 'true'">
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0" PrivateAssets="all" IncludeAssets="build" />
  </ItemGroup>

  <Target Name="BuildWebAssets">
    <Exec WorkingDirectory="$(WebUiProjectDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(WebUiProjectDirectory)" Command="npm run api:check" />
    <Exec WorkingDirectory="$(WebUiProjectDirectory)" Command="npm run build" />
    <Exec WorkingDirectory="../docs" Command="npm ci" />
    <Exec WorkingDirectory="../docs" Command="npm run build" />
    <ItemGroup>
      <WebUiFile Include="$(WebUiProjectDirectory)/dist/**" />
      <ManualFile Include="../docs/.vitepress/dist/**" />
      <WebAsset Include="@(WebUiFile)" Link="wwwroot/%(WebUiFile.RecursiveDir)%(WebUiFile.Filename)%(WebUiFile.Extension)" />
      <WebAsset Include="@(ManualFile)" Link="manual/%(ManualFile.RecursiveDir)%(ManualFile.Filename)%(ManualFile.Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedWebAssets" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildWebAssets"
          Condition="'$(GenerateEmbeddedFilesManifest)' == 'true'">
    <ItemGroup>
      <EmbeddedResource Include="@(WebAsset)" WithCulture="false" LogicalName="%(WebAsset.Link)" />
    </ItemGroup>
  </Target>

  <Target Name="PublishWebUi" AfterTargets="ComputeFilesToPublish" DependsOnTargets="BuildWebAssets"
          Condition="'$(PublishSingleFile)' != 'true' and '$(SkipWebUiBuild)' != 'true' and Exists('$(WebUiProjectDirectory)/package.json')">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(WebAsset->'%(FullPath)')" RelativePath="%(WebAsset.Link)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Import Project="GeneratedFiles.targets" />
</Project>
