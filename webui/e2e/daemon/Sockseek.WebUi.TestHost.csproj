<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The browser fixture launches this stable path without duplicating the TFM. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Match the distributed CLI-hosted daemon, rather than the Web SDK default. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Sockseek.Server/Sockseek.Server.csproj" />
    <Compile Include="../../../Sockseek.Server.Tests/SoulseekClientProxy.cs" Link="SoulseekClientProxy.cs" />
    <Compile Include="../../../tests/TestDatabase.cs" Link="TestDatabase.cs" />
  </ItemGroup>
</Project>
