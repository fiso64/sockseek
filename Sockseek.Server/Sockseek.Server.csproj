<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Avoid compiling Minimal API bindings on the first request. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <AssemblyName>Sockseek.Server</AssemblyName>
    <RootNamespace>Sockseek.Server</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>../docs</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sockseek.Api\Sockseek.Api.csproj" />
    <ProjectReference Include="..\Sockseek.Core\Sockseek.Core.csproj" />
    <ProjectReference Include="..\Sockseek.Persistence\Sockseek.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
  </ItemGroup>

</Project>
